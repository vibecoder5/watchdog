# Copy to /etc/watchdog/watchdog.env, owner root, mode 600.
# systemd EnvironmentFile syntax; this is NOT a shell script. Do not source it.
WATCHDOG_PASSWORD_HASH='$2a$12$REPLACE_WITH_GENERATED_BCRYPT_HASH'
WATCHDOG_LISTEN=127.0.0.1:8080
WATCHDOG_SECURE_COOKIE=false
# Keep false for direct localhost / SSH tunnel. For HTTPS proxy set true.
WATCHDOG_ALLOW_REMOTE=false

WATCHDOG_TELEGRAM_TOKEN=
WATCHDOG_TELEGRAM_CHAT_ID=

WATCHDOG_SMTP_HOST=
WATCHDOG_SMTP_PORT=587
WATCHDOG_SMTP_MODE=starttls
# SMTP_MODE: starttls (usually 587) or tls (usually 465). TLS verification is mandatory.
WATCHDOG_SMTP_USER=
WATCHDOG_SMTP_PASSWORD=
WATCHDOG_SMTP_FROM=
# One recipient; distribution lists can fan out to multiple addresses.
WATCHDOG_SMTP_TO=
